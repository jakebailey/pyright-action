{
    "name": "pyright-action",
    "version": "3.0.2",
    "private": true,
    "description": "GitHub Action for pyright",
    "main": "dist/index.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jakebailey/pyright-action.git"
    },
    "author": "Jake Bailey",
    "license": "MIT",
    "engines": {
        "node": ">= 24"
    },
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/http-client": "~4.0.1",
        "@actions/tool-cache": "^4.0.0",
        "@badrap/valita": "^0.5.4",
        "@iarna/toml": "^2.2.5",
        "semver": "^7.8.5",
        "shell-quote": "^1.10.0",
        "tiny-jsonc": "^1.0.2",
        "which": "^7.0.0"
    },
    "devDependencies": {
        "@dprint/json": "^0.23.0",
        "@dprint/markdown": "^0.24.0",
        "@dprint/typescript": "^0.96.1",
        "@tsconfig/node24": "^24.0.5",
        "@tsconfig/strictest": "^2.0.8",
        "@types/node": "^24.13.4",
        "@types/semver": "^7.8.0",
        "@types/shell-quote": "^1.7.5",
        "@types/which": "^3.0.4",
        "@vitest/coverage-v8": "^5.0.1",
        "dprint": "^0.57.4",
        "dprint-plugin-yaml": "^0.6.0",
        "husky": "^9.1.7",
        "klona": "^2.0.6",
        "oxlint": "^1.83.0",
        "oxlint-tsgolint": "^7.0.2001",
        "path-serializer": "^0.7.0",
        "rolldown": "1.2.8",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    },
    "scripts": {
        "prepare": "husky",
        "build": "rolldown -c",
        "lint": "oxlint . --type-aware",
        "test": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "release-it": {
        "git": {
            "commitMessage": "Release v${version}",
            "tagName": "v${version}"
        },
        "npm": {
            "publish": false
        },
        "github": {
            "release": true,
            "releaseName": "v${version}",
            "web": true
        },
        "hooks": {
            "before:init": "pnpm run test --run",
            "after:git:release": "(git tag -d v3 && git push origin :refs/tags/v3) || true && git tag v3 && git push origin v3"
        }
    },
    "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
