{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc"],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "eqeqeq": "error",
        "no-unused-vars": "off",
        "typescript/no-import-type-side-effects": "error"
    },
    "env": {
        "builtin": true,
        "node": true
    },
    "ignorePatterns": ["dist/**", "node_modules/**", "coverage/**"]
}
